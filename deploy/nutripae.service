[Unit]
Description=NutriPAE v2 — verificación del plato balanceado (FastAPI)
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/nutripae
EnvironmentFile=/home/ubuntu/nutripae/.env
# Un solo proceso: la cola de análisis (de a uno por servidor) vive dentro del proceso.
ExecStart=/home/ubuntu/nutripae/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8501 --workers 1 --proxy-headers
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
