[Unit]
Description=NutriPAE — verificación nutricional con IA (Streamlit)
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/nutripae
EnvironmentFile=/home/ubuntu/nutripae/.env
ExecStart=/home/ubuntu/nutripae/.venv/bin/streamlit run app.py \
  --server.port 8501 --server.address 127.0.0.1 --server.headless true \
  --browser.gatherUsageStats false --server.maxUploadSize 20
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
