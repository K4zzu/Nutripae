# Copia este archivo a .env y completa los valores (solo una API key es necesaria)
ANTHROPIC_API_KEY=sk-ant-...
# o, si prefieres Gemini:
# GEMINI_API_KEY=AIza...
# o, si prefieres OpenAI:
# OPENAI_API_KEY=sk-...
# Modelo opcional (por defecto claude-sonnet-5-5 / gemini-2.5-flash / gpt-4.1-mini)
# NUTRIPAE_MODELO=claude-sonnet-5-5
# Proveedor a usar si hay varias claves: anthropic | gemini | openai (por defecto, el primero con clave)
# NUTRIPAE_PROVEEDOR=openai
# Sede fija de esta estación (debe coincidir con una de la lista de la app)
# NUTRIPAE_SEDE=IE Santa Librada
# Raciones programadas por turno (barra de progreso de la estación de entrega)
# NUTRIPAE_RACIONES_TURNO=320
