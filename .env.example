# Copia este archivo a .env y completa los valores.

# Clave para firmar la sesión y cifrar los documentos de identidad. OBLIGATORIA en producción.
# Si la cambias, los códigos de documento ya cargados dejan de coincidir (volver a cargar el Excel duplica).
NUTRIPAE_SECRET=

# IA de visión: basta una de estas claves, la del proveedor elegido abajo.
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=AIza...
# Proveedor de la IA de visión: openai | anthropic | gemini.
# Sin esta variable no hay análisis con cámara: solo queda la "Práctica sin cámara".
NUTRIPAE_PROVEEDOR=openai
# Modelo opcional (por defecto gpt-4.1-mini / claude-sonnet-5-5 / gemini-2.5-flash)
# NUTRIPAE_MODELO=gpt-4.1-mini

# Contornos de los alimentos: fastsam (real) | demo (sin torch, solo para pruebas)
# NUTRIPAE_SEGMENTADOR=fastsam

# Originales sin anotar que se guardan por día y sede para entrenar el modelo propio (fase 2)
# NUTRIPAE_MUESTRA_DIA=50

# Rutas de la base de datos y de las fotos
# NUTRIPAE_DB=data/nutripae.db
# NUTRIPAE_FOTOS=data/fotos

# 1 = la cookie de sesión solo viaja por HTTPS (actívalo en el servidor con certificado)
# NUTRIPAE_HTTPS=1
